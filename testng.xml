<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full suite. Every test is tagged "regression"; the important ones are also tagged "smoke". -->
<suite name="RideMate Full Suite" verbose="1">
  <listeners>
    <listener class-name="com.ridemate.listeners.TestListener"/>
  </listeners>

  <test name="Regression Tests">
    <parameter name="browser" value="chrome"/>
    <groups><run><include name="regression"/></run></groups>
    <packages><package name="com.ridemate.tests"/></packages>
  </test>
</suite>
